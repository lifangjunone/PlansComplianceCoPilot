# Public customer-facing demo build: SSO is disabled so external users can
# access the page without ByteDance SSO. Do not rely on the internal SSO libs.
#
# IMPORTANT: Vite bakes VITE_* variables into the bundle at BUILD time, not at
# runtime. The veFaaS console "environment variables" are runtime-only and are
# NOT visible to the frontend build, so the backend URL MUST live here in the
# committed .env.prod (loaded by `vite build --mode prod`). No trailing slash,
# no /api suffix.
VITE_API_URL=https://s6mu8lcveinu7lpf8m4hk.apigateway-cn-beijing.volceapi.com
VITE_DISABLE_SSO=true
VITE_PARTITION=cn
VITE_SSO_HOST=sso.bytedance.com
VITE_AUTH_SERVICE_HOST=cloud.byted.org
